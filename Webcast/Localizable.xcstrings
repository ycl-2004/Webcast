  "strings" : {
    "确认电视已开机，手机和电视连接同一个 Wi-Fi，并在系统设置里允许 Webcast 访问本地网络。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn on your TV, connect both devices to the same Wi-Fi, and allow Local Network access for Webcast in Settings." } },
